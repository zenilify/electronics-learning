# M5Stamp S3 (ESP32-S3FN8, 8 MB flash) overrides — lane RM-1, 2026-11-11.
# Onboard WS2812B-2020 RGB LED on GPIO 21 (not exposed on the header; HYPOTHESIS from the M5 schematic,
# verified only when the LED follows the switch state). BOOT button = GPIO 0 (app_button default).
CONFIG_APP_LED_TYPE_WS2812=y
CONFIG_APP_LED_WS2812_GPIO_NUM=21
CONFIG_APP_BUTTON_GPIO_NUM=0

# 2026-11-11 12:45: the first join attempt on Mega_2.4G_7E28 ended in "AP not found" (reason 201) while BLE
# provisioning was active (Wi-Fi/BLE coexistence shortens the connect scan) and the default 3 retries were not
# enough; one failure leaves a claimed node that the app cannot re-provision (landmine 347). Retry longer.
CONFIG_APP_NETWORK_PROV_MAX_RETRY_CNT=10
