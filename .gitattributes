# Line endings: the repo stores LF and every platform checks out LF (macOS, Linux, msi/Windows).
# Prevents phantom diffs between devices and CRLF leaking into scripts copied to Linux boxes.
* text=auto eol=lf

# Windows-native scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit binary types (never touch line endings).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.uf2 binary
