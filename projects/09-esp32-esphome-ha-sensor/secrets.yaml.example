# Copy this file to secrets.yaml (same folder) and fill in real values.
# secrets.yaml is git-ignored so your Wi-Fi password and keys never get
# committed. ESPHome automatically reads secrets.yaml next to the config.

# Your Wi-Fi network.
wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password for the fallback hotspot the board creates if Wi-Fi fails.
fallback_ap_password: "changeme-fallback"

# 32-byte base64 key for the encrypted Home Assistant API connection.
# Generate one at https://esphome.io/components/api.html or with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# Password protecting over-the-air (OTA) firmware updates.
ota_password: "changeme-ota"
